# SQLite database (path is relative to prisma/schema.prisma → prisma/db/custom.db)
DATABASE_URL="file:./db/custom.db"

# ── AI provider (optional) ─────────────────────────────────────────────
# Without one of these, AI screens show "Live AI is not connected" and the
# /api/ai/* routes return 503. Nothing is faked.
#
# Option A: any OpenAI-compatible Chat Completions endpoint
AI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o-mini
#
# Option B: z-ai-web-dev-sdk — place a .z-ai-config file in the project
# root or home directory (it is git-ignored), or set:
# AI_PROVIDER=zai
